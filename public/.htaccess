RewriteEngine On # Habilita o motor de reescrita de URL do Apache dentro da pasta public.

# Se o arquivo ou diretório solicitado não existir...
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ...redireciona para index.php passando a URL como parâmetro 'url'.
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
